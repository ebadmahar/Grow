{
  "name": "grov-firebase-functions",
  "version": "1.0.0",
  "description": "Grōv Firebase Cloud Functions Backend (Node.js 20, asia-south1)",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^5.6.0",
    "axios": "^1.7.9",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "nodemailer": "^6.9.16",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "firebase-functions-test": "^3.3.0",
    "typescript": "^5.7.2"
  },
  "private": true
}
