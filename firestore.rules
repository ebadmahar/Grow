rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.isAdmin == true;
    }

    function isCoordinator() {
      return isAuthenticated() && (request.auth.token.isCoordinator == true || isAdmin());
    }

    // Users Collection
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      
      // Users may only update their own non-privileged profile attributes
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny([
             'role',
             'isDeleted',
             'totalPlanted',
             'totalSeeded',
             'totalPoints',
             'monthlyPoints',
             'activitiesCount',
             'totpEnabled',
             'mfaEnrolled',
             '_legacyId',
             '_legacyTable'
           ]);

      // Provisioning and hard deletion handled exclusively via server-side Admin SDK
      allow create, delete: if false;

      // Bounded device subcollection for FCM push tokens
      match /devices/{deviceId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Dedicated Verified Sites Collection for Viewport Map Rendering
    match /verifiedSites/{siteId} {
      allow read: if true;
      allow write: if false; // Updated exclusively via Cloud Functions (verifyActivity)
    }

    // Activities Collection (Submission and verification routed through Cloud Functions)
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow write: if false; // Mutations enforced server-side

      match /photos/{photoId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }

      match /monitoringRecords/{recordId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // Species Catalogue
    match /species/{speciesId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Community Tasks (Drives)
    match /communityTasks/{taskId} {
      allow read: if true;
      allow write: if false; // Role checks and mutations via Cloud Functions

      match /participants/{participantId} {
        allow read: if isAuthenticated();
        allow write: if false; // Capacity checking and join/leave transactions via Cloud Functions
      }
    }

    // User Interests Catalogue
    match /interests/{interestId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notifications Feed
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Users can only toggle the read status of their own notifications
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if false; // Dispatched via Admin SDK / Cloud Functions
    }

    // Environmental Issue & Bug Reports
    match /reports/{reportId} {
      allow read: if isAuthenticated() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Pre-computed Global & AQI Statistics
    match /stats/{statId} {
      allow read: if true;
      allow write: if false; // Scheduled Cloud Functions only
    }

    // Pre-computed Leaderboard
    match /leaderboard/{period} {
      allow read: if true;
      allow write: if false; // Scheduled Cloud Functions only
    }

    // System Configuration (Non-secret metadata only)
    match /config/{docId} {
      allow read, write: if isAdmin();
    }

    // Monthly Goals (Public read for mobile home screen, admin write)
    match /config/monthlyGoals/{goalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Points Ledger
    match /userPoints/{pointId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Points ledger written atomically by Cloud Functions
    }
  }
}
